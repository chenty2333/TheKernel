# Automatically detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly specify text files
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# Unified-diff context prefixes can precede source tabs or empty lines.
config/graphics/patches/** whitespace=-blank-at-eol,-space-before-tab

# Binary files
*.bin binary
*.elf binary
*.img binary
*.dbg binary
*.swp binary
*.swo binary

# Script files (keep executable)
*.sh text eol=lf

# Keep these unmodified upstream files byte-for-byte (including ACPICA CRLF).
# Only their existing end-of-line whitespace is exempt; owned vendor patches
# and all other sources retain the normal whitespace checks.
crates/ax/tk-acpica/vendor/components/dispatcher/dsmethod.c -text whitespace=-blank-at-eol
crates/ax/tk-acpica/vendor/components/parser/psopinfo.c -text whitespace=-blank-at-eol
crates/ax/tk-acpica/vendor/include/acpredef.h -text whitespace=-blank-at-eol
crates/ax/tk-acpica/vendor/include/platform/acwin.h -text whitespace=-blank-at-eol
crates/ax/tk-acpica/vendor/include/platform/aczephyr.h -text whitespace=-blank-at-eol
crates/vendor/crab-usb/README.md -text whitespace=-blank-at-eol
