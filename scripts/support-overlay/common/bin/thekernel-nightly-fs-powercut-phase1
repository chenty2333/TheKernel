#!/bin/sh

fail() {
    echo "CI_NIGHTLY_FS_POWERCUT_FAIL $1"
    exit 1
}

echo CI_NIGHTLY_FS_POWERCUT_PHASE1_START
device=
for candidate in /dev/vdc /dev/sdc; do
    if [ -e "$candidate" ]; then
        device=$candidate
        break
    fi
done
test -n "$device" || fail missing-device
mkdir -p /mnt/ci-powercut || fail mkdir
/musl/busybox mount -t ext4 "$device" /mnt/ci-powercut || fail mount-phase1
printf 'generation=1\n' >/mnt/ci-powercut/durable.new || fail durable-write
/musl/busybox sync || fail durable-sync-1
/musl/busybox mv /mnt/ci-powercut/durable.new /mnt/ci-powercut/durable \
    || fail durable-rename
/musl/busybox sync || fail durable-sync-2
printf 'may-or-may-not-survive\n' >/mnt/ci-powercut/volatile || fail volatile-write
echo CI_NIGHTLY_FS_POWERCUT_ARMED
/musl/busybox sleep 3600
