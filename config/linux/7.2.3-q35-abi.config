# Linux 7.2.3 reference kernel for the single-Q35 graphics oracle.
#
# Keep every device needed before userspace starts built in: the oracle's
# ext4 root lives on virtio-blk and its DRM/input probes must not depend on a
# module loader or an initramfs.  This is intentionally a narrow reference
# configuration, not a distribution kernel configuration.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
# Keep stack traces usable for the oracle's diagnostics without selecting the
# ORC unwinder, whose generated metadata is unnecessary for this narrow,
# built-in reference configuration.
# CONFIG_UNWINDER_ORC is not set
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MSI_IRQ_DOMAIN=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_ACPI=y
CONFIG_ACPI_PCI_SLOT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_INOTIFY_USER=y

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_UNIX=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
# CONFIG_MODULES is not set

# ---------------------------------------------------------------------------
# Syscall-ABI oracle additions.
#
# The graphics configuration above was written to verify virtio-gpu, DRM and
# evdev, and the syscall-ABI work inherited it as its reference kernel.  Those
# cells whose feature is off in the graphics configuration therefore had no
# reference to compare against and could only be recorded, never verified.
#
# Everything below is additive: it turns features on that the ABI contracts
# need.  It is NOT a distribution configuration, and it does not relax any of
# the required_settings the build script checks.  Any change here changes the
# oracle for every existing contract, so the whole differential must be re-run
# against the rebuilt kernel before it is adopted.
# ---------------------------------------------------------------------------

CONFIG_USERFAULTFD=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CRYPTO_USER=y
CONFIG_XDP_SOCKETS=y
CONFIG_TIME_NS=y

# Restore what the graphics fragment leaves to defconfig but the oracle in use
# actually has.  The graphics fragment does not mention landlock, and
# defconfig leaves it off, so a rebuild from the fragment alone silently
# dropped it and the landlock ABI suite answered ENOSYS.
CONFIG_SECURITY_LANDLOCK=y

# Deliberately NOT enabled: CONFIG_KSM and CONFIG_WATCH_QUEUE.  TheKernel has
# neither, and the differential already pins their absence from the target
# configuration (madvise MADV_MERGEABLE is unavailable, O_NOTIFICATION_PIPE is
# refused).  Turning them on would not reveal a new gap in a partial cell; it
# would only turn two passing contracts red for a feature outside this task.
