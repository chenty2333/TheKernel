# Interactive Weston desktop; smoke workloads stay disabled.
# Carry both software KMS and the virtio-gpu virgl driver.
BR2_ROOTFS_OVERLAY="@REPO_ROOT@/config/graphics/overlay/common @REPO_ROOT@/config/graphics/overlay/q35-software-desktop"
BR2_ROOTFS_POST_BUILD_SCRIPT="@REPO_ROOT@/config/graphics/build-guest-tools.sh @REPO_ROOT@/config/graphics/build-q35-wayland-client.sh"
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt @REPO_ROOT@/config/graphics/desktop-permissions.table"
BR2_GLOBAL_PATCH_DIR="@REPO_ROOT@/config/graphics/patches"
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_HEADLESS=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y
BR2_GENERATE_LOCALE="C.UTF-8"
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_KMSCUBE=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PCMANFM=y
BR2_PACKAGE_LIBGTK3_WAYLAND=y
# BR2_PACKAGE_LIBGTK3_BROADWAY is not set
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_XAPP_XEDIT=y
BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
BR2_PACKAGE_XFONT_FONT_ALIAS=y
BR2_PACKAGE_FEH=y
# Reuse GTK3 and the upstream WebKit browser, including its process sandbox.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_WEBKITGTK=y
BR2_PACKAGE_WEBKITGTK_MINIBROWSER=y
BR2_PACKAGE_WEBKITGTK_WAYLAND=y
BR2_PACKAGE_WEBKITGTK_X11=y
BR2_PACKAGE_WEBKITGTK_SANDBOX=y
BR2_PACKAGE_WEBKITGTK_HTTPS=y
BR2_PACKAGE_WEBKITGTK_MULTIMEDIA=y
BR2_PACKAGE_PULSEAUDIO=y
# BR2_PACKAGE_PULSEAUDIO_DAEMON is not set
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_PULSE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOTESTSRC=y
BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIBCURL_VERBOSE=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
# BR2_PACKAGE_OPENSSH_SERVER is not set
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_PIGLIT=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_LIBEPOXY=y
BR2_TARGET_ROOTFS_EXT2_SIZE="3G"
# Allow X11 applications through rootless Xwayland.
BR2_PACKAGE_WESTON_XWAYLAND=y
# BR2_PACKAGE_WLROOTS is not set
