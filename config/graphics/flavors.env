# Single source of truth for the Buildroot graphics rootfs flavors.
#
# This file is parsed twice: sourced by bash in
# scripts/build-graphics-rootfs.sh and read as plain KEY=VALUE lines by
# Python (tools/thekernel.py and the host tests).  Keep it to simple
# KEY=VALUE assignments: no arrays, no expansions, no nested quoting.
# Values containing spaces are double-quoted; lists are space-separated.
#
# Per-flavor keys use the flavor name uppercased with dashes turned into
# underscores, e.g. q35-graphics-seatd -> FLAVOR_Q35_GRAPHICS_SEATD_*:
#   OVERLAY   overlay directory below config/graphics/overlay
#   SESSION   session stack: seatd or logind
#   BACKEND   Weston backend expected in the built rootfs, or "none"
FLAVORS="headless-abi-smoke q35-graphics-seatd q35-software-desktop q35-graphics-benchmark q35-venus-desktop q35-graphics-logind"
CI_CHECK_FLAVORS="q35-graphics-seatd q35-software-desktop"

FLAVOR_HEADLESS_ABI_SMOKE_OVERLAY=headless
FLAVOR_HEADLESS_ABI_SMOKE_SESSION=seatd
FLAVOR_HEADLESS_ABI_SMOKE_BACKEND=headless-backend.so

FLAVOR_Q35_GRAPHICS_SEATD_OVERLAY=q35-graphics-seatd
FLAVOR_Q35_GRAPHICS_SEATD_SESSION=seatd
FLAVOR_Q35_GRAPHICS_SEATD_BACKEND=drm-backend.so

FLAVOR_Q35_SOFTWARE_DESKTOP_OVERLAY=q35-software-desktop
FLAVOR_Q35_SOFTWARE_DESKTOP_SESSION=seatd
FLAVOR_Q35_SOFTWARE_DESKTOP_BACKEND=drm-backend.so

FLAVOR_Q35_GRAPHICS_BENCHMARK_OVERLAY=q35-graphics-benchmark
FLAVOR_Q35_GRAPHICS_BENCHMARK_SESSION=seatd
FLAVOR_Q35_GRAPHICS_BENCHMARK_BACKEND=drm-backend.so

FLAVOR_Q35_VENUS_DESKTOP_OVERLAY=q35-venus-desktop
FLAVOR_Q35_VENUS_DESKTOP_SESSION=seatd
FLAVOR_Q35_VENUS_DESKTOP_BACKEND=drm-backend.so

FLAVOR_Q35_GRAPHICS_LOGIND_OVERLAY=q35-graphics-logind
FLAVOR_Q35_GRAPHICS_LOGIND_SESSION=logind
FLAVOR_Q35_GRAPHICS_LOGIND_BACKEND=none
