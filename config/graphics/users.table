# The compositor receives card and input devices through libseat -> seatd.
# Render nodes and the playback device are direct-access exceptions;
# do not add video or input supplementary groups.
# Keep persistent home ownership independent of the selected Buildroot packages.
weston 102 weston 107 !* /var/lib/weston /bin/sh seat,render,audio Weston compositor

# Stable named policy groups for the graphics device rules below. seatd
# provides the seat group itself; these entries make group ownership visible
# even on a minimal rootfs that otherwise has none of these groups.
- - video -1 - - - -
- - input -1 - - - -
- - render -1 - - - -
- - audio -1 - - - -
