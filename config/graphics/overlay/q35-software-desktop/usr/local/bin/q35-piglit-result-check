#!/usr/bin/env python3
"""Validate the outcome summary produced by a bounded Piglit run."""

from __future__ import annotations

import bz2
import json
import sys
from collections import Counter
from pathlib import Path
from typing import Any


ALLOWED_RESULTS = frozenset({"pass", "skip", "warn", "notrun"})
MAX_FAILURE_DETAILS = 16
MAX_DETAIL_CHARS = 1024


def result_file(argument: str) -> Path:
    """Return the compressed Piglit JSON file named by *argument*."""
    path = Path(argument)
    return path / "results.json.bz2" if path.is_dir() else path


def read_results(path: Path) -> dict[str, Any]:
    try:
        with bz2.open(path, "rt", encoding="utf-8") as source:
            document = json.load(source)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read Piglit results {path}: {exc}") from exc

    if not isinstance(document, dict):
        raise ValueError("Piglit results document is not an object")
    tests = document.get("tests")
    if not isinstance(tests, dict) or not tests:
        raise ValueError("Piglit results must contain a nonempty tests mapping")
    return tests


def count_results(tests: dict[str, Any]) -> Counter[str]:
    counts: Counter[str] = Counter()
    for name, record in tests.items():
        if not isinstance(name, str) or not isinstance(record, dict):
            raise ValueError("Piglit tests mapping contains an invalid test record")
        result = record.get("result")
        if not isinstance(result, str):
            raise ValueError(f"Piglit test {name!r} has no string result")
        counts[result] += 1
    return counts


def report_failures(tests: dict[str, Any], errors: int) -> None:
    """Expose bounded native test output, not environment or command metadata."""
    reported = 0
    for name, record in tests.items():
        if record["result"] in ALLOWED_RESULTS:
            continue
        if reported == MAX_FAILURE_DETAILS:
            break
        detail = {"name": name, "result": record["result"]}
        for field in ("out", "err"):
            value = record.get(field)
            if isinstance(value, str) and value:
                detail[field] = value
        detail = {
            key: value[:MAX_DETAIL_CHARS] + ("...[truncated]" if len(value) > MAX_DETAIL_CHARS else "")
            for key, value in detail.items()
        }
        # JSON escaping prevents test newlines/terminal controls from forging
        # runner markers, while preserving useful shader/compiler diagnostics.
        print("q35-piglit-result-check: failure " + json.dumps(detail), file=sys.stderr)
        reported += 1
    if errors > reported:
        print(f"q35-piglit-result-check: {errors - reported} further failures omitted", file=sys.stderr)


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print(f"usage: {Path(sys.argv[0]).name} RESULTS_DIR_OR_JSON_BZ2", file=sys.stderr)
        return 2

    try:
        path = result_file(arguments[0])
        tests = read_results(path)
        counts = count_results(tests)
    except ValueError as exc:
        print(f"q35-piglit-result-check: {exc}", file=sys.stderr)
        return 2

    ordered_counts = " ".join(f"{result}={counts[result]}" for result in sorted(counts))
    errors = sum(count for result, count in counts.items() if result not in ALLOWED_RESULTS)
    print(f"THEKERNEL_Q35_VIRGL_PIGLIT_RESULTS {ordered_counts} errors={errors}")
    report_failures(tests, errors)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
