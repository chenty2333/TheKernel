#!/bin/sh
# Keep this deliberately bounded: quick is the Phase-5 conformance smoke, not
# a replacement for the full nightly Piglit profile.
set -eu

runner=/usr/bin/piglit
[ -x "$runner" ] || { echo 'THEKERNEL_Q35_VIRGL_PIGLIT_READY state=FAIL reason=piglit'; exit 1; }
command -v wflinfo >/dev/null || { echo 'THEKERNEL_Q35_VIRGL_PIGLIT_READY state=FAIL reason=waffle'; exit 1; }

results=/tmp/thekernel-piglit-quick
rm -rf "$results"
mkdir -p "$results"
MESA_LOADER_DRIVER_OVERRIDE=virgl "$runner" run \
    -p wayland -1 --timeout 60 quick "$results" || {
    echo 'THEKERNEL_Q35_VIRGL_PIGLIT_READY state=FAIL reason=piglit_quick'
    exit 1
}
checker=/usr/local/bin/q35-piglit-result-check
[ -x "$checker" ] || { echo 'THEKERNEL_Q35_VIRGL_PIGLIT_READY state=FAIL reason=piglit_result_check'; exit 1; }
"$checker" "$results" || {
    echo 'THEKERNEL_Q35_VIRGL_PIGLIT_READY state=FAIL reason=piglit_result_check'
    exit 1
}
echo THEKERNEL_Q35_VIRGL_PIGLIT_READY
