#!/bin/sh
set -eu

# Other graphics flavors inherit this overlay but keep their smoke rootfs.
grep -qx q35-software-desktop /etc/thekernel-graphics-flavor || exit 0

home_dir=/var/lib/weston
case "${1:-}" in
    start)
        [ -b /dev/vdb ] || { echo "Desktop home disk missing: /dev/vdb" >&2; exit 1; }
        mkdir -p "$home_dir"
        mountpoint -q "$home_dir" || mount -t ext4 /dev/vdb "$home_dir"
        # This disk belongs to the desktop user. Older images allocated its
        # IDs dynamically, leaving existing 0700 configuration directories
        # inaccessible after packages added another account. Repair only
        # mismatched ownership, without following symlinks outside the home.
        desktop_uid=$(id -u weston)
        desktop_gid=$(id -g weston)
        find "$home_dir" -xdev \( ! -user "$desktop_uid" -o ! -group "$desktop_gid" \) \
            -exec chown -h "$desktop_uid:$desktop_gid" {} +
        chmod 0700 "$home_dir"
        for name in Documents Pictures Downloads; do
            directory=$home_dir/$name
            if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
                mkdir -m 0700 "$directory"
                chown weston:weston "$directory"
            fi
        done
        ;;
    stop)
        sync
        if mountpoint -q "$home_dir"; then
            umount "$home_dir"
        fi
        ;;
    *) echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
