#!/bin/sh
# Exercise the direct GBM/EGL/KMS path before Weston obtains DRM master. A
# software virtio-gpu may still expose a render node, so select this workload
# only when the VirtGPU 3D feature and a Virgl capset are usable.
set -eu
[ "${1:-start}" = start ] || exit 0

# The interactive desktop keeps Weston and its applications running.
grep -qx q35-software-desktop /etc/thekernel-graphics-flavor && exit 0

marker=THEKERNEL_Q35_VIRGL_KMSCUBE_READY
virgl_status=0
/usr/local/bin/q35-virgl-render-oracle --supports-virgl || virgl_status=$?
case "$virgl_status" in
    0) ;;
    1) exit 0 ;;
    *) echo "$marker state=FAIL reason=virgl_capability_query"; exit 1 ;;
esac
[ -c /dev/dri/card0 ] || { echo "$marker state=FAIL reason=card0"; exit 1; }

MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu kmscube --count=120 || {
    echo "$marker state=FAIL reason=kmscube"
    exit 1
}
echo "$marker"
