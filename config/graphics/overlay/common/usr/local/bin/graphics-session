#!/bin/sh
# Run only as the unprivileged weston account (S80weston uses -c weston).
set -eu

runtime_dir=/run/user/$(id -u)
export HOME=/var/lib/weston
export XDG_RUNTIME_DIR="$runtime_dir"
export LIBSEAT_BACKEND=seatd
[ "$(id -u)" -ne 0 ]
[ -d "$XDG_RUNTIME_DIR" ]
[ "$(stat -c %u "$XDG_RUNTIME_DIR")" = "$(id -u)" ]
[ "$(stat -c %a "$XDG_RUNTIME_DIR")" = 700 ]

# Each flavor overlay selects the backend through its weston.ini symlink.
set -- --config=/etc/weston/weston.ini --socket=wayland-0 --log="$XDG_RUNTIME_DIR/weston.log"
# This shared image includes EGL, so AUTO selects GL even on the software
# device. Select Pixman explicitly for both software desktop flavors.
if grep -Eqx 'q35-(graphics-seatd|software-desktop)' /etc/thekernel-graphics-flavor &&
    [ ! -c /dev/dri/renderD128 ]; then
    set -- "$@" --renderer=pixman
fi
exec weston "$@"
