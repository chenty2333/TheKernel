#!/bin/sh
# Run only as the unprivileged weston account (S80weston uses -c weston).
set -eu

runtime_dir=/run/user/$(id -u)
export HOME=/var/lib/weston
export XDG_RUNTIME_DIR="$runtime_dir"
export LIBSEAT_BACKEND=seatd
[ "$(id -u)" -ne 0 ]
[ -d "$XDG_RUNTIME_DIR" ]
[ "$(stat -c %u "$XDG_RUNTIME_DIR")" = "$(id -u)" ]
[ "$(stat -c %a "$XDG_RUNTIME_DIR")" = 700 ]

# Each flavor overlay links /etc/weston/weston.ini to its checked-in headless
# or DRM configuration, so the session itself is flavor-independent.
exec weston --config=/etc/weston/weston.ini \
    --log="$XDG_RUNTIME_DIR/weston.log"
