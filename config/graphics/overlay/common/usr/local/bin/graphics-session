#!/bin/sh
# Run only as the unprivileged weston account (S80weston uses -c weston).
set -eu

runtime_dir=/run/user/$(id -u)
export HOME=/var/lib/weston
export XDG_RUNTIME_DIR="$runtime_dir"
export LIBSEAT_BACKEND=seatd
# start-stop-daemon closes the background child's standard streams. Capture
# failures before Weston opens its own log, including config and Pulse setup.
exec >> "$XDG_RUNTIME_DIR/graphics-session.log" 2>&1
stage="runtime directory validation"
trap 'status=$?; if [ "$status" -ne 0 ]; then echo "graphics-session failed during $stage (exit $status)" >&2; fi' 0
[ "$(id -u)" -ne 0 ]
[ -d "$XDG_RUNTIME_DIR" ]
[ "$(stat -c %u "$XDG_RUNTIME_DIR")" = "$(id -u)" ]
[ "$(stat -c %a "$XDG_RUNTIME_DIR")" = 700 ]

# Each flavor overlay selects the backend through its weston.ini symlink.
set -- --config=/etc/weston/weston.ini --socket=wayland-0 --log="$XDG_RUNTIME_DIR/weston.log"
# DRM's DRIVER_RENDER flag only determines whether a render node may exist;
# the virtio driver advertises it even when 3D is disabled.  Select Weston GL
# only when the render-node UAPI reports a usable Virgl capset.  Venus and
# software-only VirtIO devices use the Pixman compositor (Venus is exercised
# separately by the Vulkan WSI client).
if grep -Eqx 'q35-(graphics-seatd|software-desktop|venus-desktop)' /etc/thekernel-graphics-flavor; then
    virgl_status=0
    /usr/local/bin/q35-virgl-render-oracle --supports-virgl || virgl_status=$?
    case "$virgl_status" in
        0) set -- "$@" --renderer=gl ;;
        1) set -- "$@" --renderer=pixman ;;
        *) echo "Virgl capability probe failed (exit $virgl_status)" >&2; exit 1 ;;
    esac
elif grep -qx n305-iris-smoke /etc/thekernel-graphics-flavor; then
    if [ -c /dev/dri/renderD128 ]; then
        set -- "$@" --renderer=gl
    else
        set -- "$@" --renderer=pixman
    fi
elif [ -c /dev/dri/renderD128 ]; then
    set -- "$@" --renderer=gl
fi
if grep -qx q35-software-desktop /etc/thekernel-graphics-flavor; then
    stage="desktop user configuration"
    config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
    mkdir -p "$config_dir"
    if [ ! -e "$config_dir/user-dirs.dirs" ] && [ ! -L "$config_dir/user-dirs.dirs" ]; then
        cp /etc/xdg/user-dirs.dirs "$config_dir/user-dirs.dirs"
    fi
    stage="PulseAudio startup"
    pulseaudio --start --exit-idle-time=-1 --log-target="file:$XDG_RUNTIME_DIR/pulse.log"
fi
stage="Weston exec"
exec weston "$@"
