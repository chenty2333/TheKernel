#!/bin/sh
# This is intentionally after S70seatd.  It prepares a per-user runtime
# directory on /run (a tmpfs from Buildroot's SysV skeleton) before dropping
# privileges to the compositor account.
set -eu

USER=weston
UID=$(id -u "$USER")
RUNTIME_DIR=/run/user/$UID
PIDFILE=/run/weston.pid
SESSION=/usr/local/bin/graphics-session
FLAVOR_FILE=/etc/thekernel-graphics-flavor

running() {
    pid_from_file >/dev/null 2>&1 && kill -0 "$(pid_from_file)" 2>/dev/null
}

pid_from_file() {
    [ -r "$PIDFILE" ] || return 1
    IFS= read -r pid <"$PIDFILE" || return 1
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
        *) printf '%s\n' "$pid" ;;
    esac
}

wait_for_exit() {
    pid=$1
    tries=0
    while kill -0 "$pid" 2>/dev/null; do
        [ "$tries" -lt 10 ] || return 1
        tries=$((tries + 1))
        sleep 1
    done
}

graphics_flavor() {
    [ -r "$FLAVOR_FILE" ] || {
        echo "missing graphics flavor file: $FLAVOR_FILE" >&2
        return 1
    }
    flavor=$(cat "$FLAVOR_FILE")
    case "$flavor" in
        headless-abi-smoke|q35-graphics-seatd|q35-software-desktop|q35-venus-desktop) printf '%s\n' "$flavor" ;;
        *)
            echo "invalid graphics flavor in $FLAVOR_FILE" >&2
            return 1
            ;;
    esac
}

start() {
    running && return 0
    flavor=$(graphics_flavor)
    mkdir -p "$RUNTIME_DIR"
    chown "$USER:$USER" "$RUNTIME_DIR"
    chmod 0700 "$RUNTIME_DIR"
    printf 'Starting Weston (%s): ' "$flavor"
    start-stop-daemon -S -x "$SESSION" -p "$PIDFILE" -m -b -c "$USER" -- \
        "$flavor"
    echo OK
}

stop() {
    pid=$(pid_from_file) || { rm -f "$PIDFILE"; return 0; }
    kill -0 "$pid" 2>/dev/null || { rm -f "$PIDFILE"; return 0; }
    printf 'Stopping Weston: '
    kill -TERM "$pid" 2>/dev/null || true
    if ! wait_for_exit "$pid"; then
        printf 'TERM timeout; sending KILL: ' >&2
        kill -KILL "$pid" 2>/dev/null || true
        if ! wait_for_exit "$pid"; then
            echo FAIL >&2
            return 1
        fi
    fi
    # A dead Weston necessarily closed its DRM-master FD.  Do not remove this
    # PID file before that point: modeset helpers use stop's success as their
    # ownership hand-off.
    rm -f "$PIDFILE"
    echo OK
}

case "${1:-}" in
    start|stop) "$1" ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
