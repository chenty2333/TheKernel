#!/bin/sh
# This is intentionally after S70seatd.  It prepares a per-user runtime
# directory on /run (a tmpfs from Buildroot's SysV skeleton) before dropping
# privileges to the compositor account.
set -eu

USER=weston
UID=$(id -u "$USER")
RUNTIME_DIR=/run/user/$UID
PIDFILE=/run/weston.pid
SESSION=/usr/local/bin/graphics-session
WESTON_HOME_MOUNT=
[ ! -r /etc/default/weston ] || . /etc/default/weston

running() {
    pid_from_file >/dev/null 2>&1 && kill -0 "$(pid_from_file)" 2>/dev/null
}

pid_from_file() {
    [ -r "$PIDFILE" ] || return 1
    IFS= read -r pid <"$PIDFILE" || return 1
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
        *) printf '%s\n' "$pid" ;;
    esac
}

wait_for_exit() {
    pid=$1
    tries=0
    while kill -0 "$pid" 2>/dev/null; do
        [ "$tries" -lt 10 ] || return 1
        tries=$((tries + 1))
        sleep 1
    done
}

wait_for_ready() {
    tries=0
    while [ "$tries" -lt 20 ]; do
        if running && [ -S "$RUNTIME_DIR/wayland-0" ]; then
            return 0
        fi
        # The daemon writes its PID before exec. Once it has exited there is
        # no reason to wait out the remaining startup deadline.
        if pid_from_file >/dev/null 2>&1 && ! running; then
            return 1
        fi
        tries=$((tries + 1))
        sleep 1
    done
    return 1
}

report_start_failure() {
    echo "FAIL: Weston did not create a live Wayland socket" >&2
    for name in graphics-session.log pulse.log weston.log; do
        if [ -r "$RUNTIME_DIR/$name" ]; then
            echo "--- $RUNTIME_DIR/$name ---" >&2
            tail -n 40 "$RUNTIME_DIR/$name" >&2
        fi
    done
}

start() {
    if running; then
        wait_for_ready && return 0
        report_start_failure
        return 1
    fi
    if [ -n "$WESTON_HOME_MOUNT" ] && ! mountpoint -q "$WESTON_HOME_MOUNT"; then
        echo "Cannot start desktop: persistent home disk is not mounted" >&2
        return 1
    fi
    if [ -n "$WESTON_HOME_MOUNT" ]; then
        [ -c /dev/dsp ] || { echo "Desktop playback device missing: /dev/dsp" >&2; return 1; }
        chgrp audio /dev/dsp
        chmod 0660 /dev/dsp
    fi
    mkdir -p "$RUNTIME_DIR"
    chown "$USER:$USER" "$RUNTIME_DIR"
    chmod 0700 "$RUNTIME_DIR"
    # Weston binds the Xwayland socket before launching Xwayland. Prepare
    # its shared directory as root before dropping compositor privileges.
    mkdir -p /tmp/.X11-unix
    chown root:root /tmp/.X11-unix
    chmod 1777 /tmp/.X11-unix
    # No live managed process owns these paths. A stale socket must not make
    # the newly forked launcher appear ready before it executes Weston.
    rm -f "$PIDFILE" "$RUNTIME_DIR/wayland-0" "$RUNTIME_DIR/wayland-0.lock"
    for name in graphics-session.log pulse.log weston.log; do
        : > "$RUNTIME_DIR/$name"
        chown "$USER:$USER" "$RUNTIME_DIR/$name"
        chmod 0600 "$RUNTIME_DIR/$name"
    done
    printf 'Starting Weston: '
    if start-stop-daemon -S -x "$SESSION" -p "$PIDFILE" -m -b -O "$RUNTIME_DIR/graphics-session.log" -c "$USER" && wait_for_ready; then
        echo OK
        return 0
    fi
    report_start_failure
    stop || true
    return 1
}

stop() {
    if [ -n "$WESTON_HOME_MOUNT" ]; then
        # Pulse holds the playback device and writes user state. Stop it before
        # the later home unmount, even if the compositor has already exited.
        start-stop-daemon -K -q -x /usr/bin/pulseaudio -u "$USER" || true
        tries=0
        while start-stop-daemon -K -q -t -x /usr/bin/pulseaudio -u "$USER"; do
            [ "$tries" -lt 10 ] || { echo "PulseAudio did not stop" >&2; return 1; }
            tries=$((tries + 1))
            sleep 1
        done
    fi
    pid=$(pid_from_file) || { rm -f "$PIDFILE"; return 0; }
    kill -0 "$pid" 2>/dev/null || { rm -f "$PIDFILE"; return 0; }
    printf 'Stopping Weston: '
    kill -TERM "$pid" 2>/dev/null || true
    if ! wait_for_exit "$pid"; then
        printf 'TERM timeout; sending KILL: ' >&2
        kill -KILL "$pid" 2>/dev/null || true
        if ! wait_for_exit "$pid"; then
            echo FAIL >&2
            return 1
        fi
    fi
    # A dead Weston necessarily closed its DRM-master FD.  Do not remove this
    # PID file before that point: modeset helpers use stop's success as their
    # ownership hand-off.
    rm -f "$PIDFILE"
    echo OK
}

case "${1:-}" in
    start|stop) "$1" ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
