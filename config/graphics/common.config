# Buildroot 2026.05.2, x86_64 glibc userspace.  TheKernel kernel is deliberately
# not built here: this rootfs is an ABI probe against the checked-out kernel.
BR2_x86_64=y
BR2_x86_core2=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Keep userspace UAPI headers on the Linux 6.12 LTS series. Buildroot's pinned
# release supplies and verifies the exact stable tarball used for this series.
BR2_KERNEL_HEADERS_6_12=y
# BusyBox runs the SysV-style scripts supplied by eudev and seatd.  This is a
# seatd/libseat system: it deliberately does not select systemd or logind.
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="@REPO_ROOT@/config/graphics/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="thekernel-graphics"
BR2_TARGET_GENERIC_ISSUE="TheKernel graphics ABI probe"
BR2_REPRODUCIBLE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# lwext4 rejects these newer host-e2fsprogs incompatible features.  Keep the
# generated image within the filesystem feature set TheKernel actually mounts.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^metadata_csum_seed,^orphan_file"
BR2_ROOTFS_USERS_TABLES="@REPO_ROOT@/config/graphics/users.table"

# Stage-one userspace.  pixman is selected explicitly even though Weston also
# depends on it, so dependency drift is visible in the resolved configuration.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_WESTON=y
# q35 desktop supports both a deterministic pixman/SHM path and the existing
# virgl EGL client.  Xwayland remains rootless under Weston; do not select an
# independent Xorg server or a wlroots/logind stack here.
BR2_ROOTFS_OVERLAY="@REPO_ROOT@/config/graphics/overlay/common @REPO_ROOT@/config/graphics/overlay/q35-software-desktop"
BR2_ROOTFS_POST_BUILD_SCRIPT="@REPO_ROOT@/config/graphics/build-guest-tools.sh @REPO_ROOT@/config/graphics/build-q35-wayland-client.sh"
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_HEADLESS=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_WESTON_XWAYLAND=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_LIBXCB=y
# BR2_PACKAGE_WLROOTS is not set
