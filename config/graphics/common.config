# Buildroot 2025.02.2, x86_64 glibc userspace.  TheKernel kernel is deliberately
# not built here: this rootfs is an ABI probe against the checked-out kernel.
BR2_x86_64=y
BR2_x86_core2=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# BusyBox runs the SysV-style scripts supplied by eudev and seatd.  This is a
# seatd/libseat system: it deliberately does not select systemd or logind.
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="thekernel-graphics"
BR2_TARGET_GENERIC_ISSUE="TheKernel graphics ABI probe"
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_ROOTFS_USERS_TABLES="@REPO_ROOT@/config/graphics/users.table"

# Stage-one userspace.  pixman is selected explicitly even though Weston also
# depends on it, so dependency drift is visible in the resolved configuration.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_WESTON=y
