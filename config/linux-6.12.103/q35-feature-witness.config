# Explicit witness for Linux ABI features that are disabled in the q35 product
# oracle and enabled here for positive, configuration-gated ABI comparison.
# Keep every assignment explicit: the CI verifier rejects duplicate or
# conflicting assignments.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KEXEC_FILE=y
CONFIG_BPF_SYSCALL=y
CONFIG_USER_NS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_USERFAULTFD=y
