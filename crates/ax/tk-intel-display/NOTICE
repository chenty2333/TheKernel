  drivers/gpu/drm/i915/display/intel_display_device.c:
  adl_p_steppings, adl_p_adl_n_steppings, get_pre_gmdid_step, xe_lpd_display
  Copyright © 2023 Intel Corporation.
  include/drm/intel/pciids.h (PCI identity facts): Copyright 2013 Intel Corporation.
src/bios.rs:
  drivers/gpu/drm/i915/display/intel_bios.c:
  intel_bios_is_valid_vbt, _get_blocksize, find_raw_section,
  child_device_expected_size, parse_general_definitions, dvo_port_to_port,
  map_ddc_pin, intel_bios_encoder_supports_{dvi,hdmi,dp,edp,typec_usb,tbt},
  intel_bios_hdmi_max_tmds_clock, sanitize_dedicated_external
  Copyright © 2006 Intel Corporation.
  drivers/gpu/drm/i915/display/intel_vbt_defs.h: selected byte-layout fields
