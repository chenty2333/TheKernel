{
  "schema": "syz-differential-semantics-v0",
  "name": "timerfd",
  "marker_prefix": "TIMERFDGEN",
  "c_includes": ["sys/timerfd.h", "time.h"],
  "checks": [
    {
      "marker": "CREATE_MONOTONIC",
      "locals": {},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "CREATE_REALTIME",
      "locals": {},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_REALTIME", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "CREATE_BOOTTIME",
      "locals": {},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_BOOTTIME", "TFD_CLOEXEC"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "CREATE_BADCLOCK",
      "locals": {},
      "steps": [
        {"call": "timerfd_create", "args": ["99", "0"],
         "expect": {"ret": "-1", "errno": "EINVAL"}}
      ]
    },
    {
      "marker": "CREATE_BADFLAGS",
      "locals": {},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "1"],
         "expect": {"ret": "-1", "errno": "EINVAL"}}
      ]
    },
    {
      "marker": "SETTIME_BADFLAGS",
      "locals": {"its": "itimerspec"},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"set": "its.it_value.tv_nsec", "value": 1000000},
        {"call": "timerfd_settime", "args": ["@tfd", "0x10", "&its", "0"],
         "expect": {"ret": "-1", "errno": "EINVAL"}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "SETTIME_BADNSEC",
      "locals": {"its": "itimerspec"},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"set": "its.it_value.tv_nsec", "value": 2000000000},
        {"call": "timerfd_settime", "args": ["@tfd", "0", "&its", "0"],
         "expect": {"ret": "-1", "errno": "EINVAL"}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "SETTIME_BADFD",
      "locals": {"its": "itimerspec"},
      "steps": [
        {"set": "its.it_value.tv_nsec", "value": 1000000},
        {"call": "timerfd_settime", "args": ["-1", "0", "&its", "0"],
         "expect": {"ret": "-1", "errno": "EBADF"}}
      ]
    },
    {
      "marker": "GETTIME_DISARMED",
      "locals": {"cur": "itimerspec"},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"call": "timerfd_gettime", "args": ["@tfd", "&cur"],
         "expect": {"ret": "0"}},
        {"expect": {"var": "cur.it_value.tv_sec", "cmp": "==", "value": 0}},
        {"expect": {"var": "cur.it_value.tv_nsec", "cmp": "==", "value": 0}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "SETTIME_GETTIME_ARMED",
      "locals": {"its": "itimerspec", "cur": "itimerspec"},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"set": "its.it_value.tv_nsec", "value": 100000000},
        {"call": "timerfd_settime", "args": ["@tfd", "0", "&its", "0"],
         "expect": {"ret": "0"}},
        {"call": "timerfd_gettime", "args": ["@tfd", "&cur"],
         "expect": {"ret": "0"}},
        {"expect": {"var": "cur.it_value.tv_sec", "cmp": "==", "value": 0}},
        {"expect": {"var": "cur.it_value.tv_nsec", "cmp": ">", "value": 0}},
        {"expect": {"var": "cur.it_interval.tv_sec", "cmp": "==", "value": 0}},
        {"expect": {"var": "cur.it_interval.tv_nsec", "cmp": "==", "value": 0}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    },
    {
      "marker": "READ_EXPIRATION_COUNT",
      "locals": {"its": "itimerspec", "exps": "u64"},
      "steps": [
        {"call": "timerfd_create", "args": ["CLOCK_MONOTONIC", "0"],
         "save": "tfd", "expect": {"ret": ">=0"}},
        {"set": "its.it_value.tv_nsec", "value": 20000000},
        {"call": "timerfd_settime", "args": ["@tfd", "0", "&its", "0"],
         "expect": {"ret": "0"}},
        {"call": "read$timerfd", "args": ["@tfd", "&exps", "8"],
         "expect": {"ret": "8"}},
        {"expect": {"var": "exps", "cmp": "==", "value": 1}},
        {"call": "close$timerfd", "args": ["@tfd"], "expect": {"ret": "0"}}
      ]
    }
  ]
}
