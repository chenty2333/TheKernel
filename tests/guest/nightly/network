#!/bin/sh

peer_port=${1:-}
peer_nonce=${2:-}
case "$peer_port" in
    ''|*[!0-9]*) echo 'CI_NIGHTLY_NONLOOPBACK_NETWORK_FAIL invalid-port'; exit 1 ;;
esac
case "$peer_nonce" in
    ''|*[!0-9a-f]*) echo 'CI_NIGHTLY_NONLOOPBACK_NETWORK_FAIL invalid-nonce'; exit 1 ;;
esac

fail() {
    echo "CI_NIGHTLY_NONLOOPBACK_NETWORK_FAIL $1"
    exit 1
}

echo CI_NIGHTLY_NONLOOPBACK_NETWORK_START
rm -f /tmp/ci-network-reply
printf 'THEKERNEL_NETWORK_PROBE %s\n' "$peer_nonce" \
    | /bin/busybox nc -w 30 10.0.2.2 "$peer_port" \
        >/tmp/ci-network-reply
network_status=$?
test "$network_status" -eq 0 || fail connect
test "$(cat /tmp/ci-network-reply)" = "THEKERNEL_NETWORK_REPLY $peer_nonce" \
    || fail payload
rm -f /tmp/ci-network-reply
echo CI_NIGHTLY_NONLOOPBACK_NETWORK_PASS
