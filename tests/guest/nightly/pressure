#!/bin/sh

iterations=${1:-16}
case "$iterations" in
    ''|*[!0-9]*|0) echo 'CI_NIGHTLY_PRESSURE_FAIL invalid-iterations'; exit 1 ;;
esac

fail() {
    echo "CI_NIGHTLY_PRESSURE_FAIL $1"
    exit 1
}

echo CI_NIGHTLY_PRESSURE_START
test -x /opt/thekernel-tests/bin/thekernel-hackstress || fail missing-hackstress
test -x /opt/thekernel-tests/bin/thekernel-signal-mask-alias \
    || fail missing-signal-mask-alias
/opt/thekernel-tests/bin/thekernel-signal-mask-alias || fail signal-mask-alias
/opt/thekernel-tests/bin/thekernel-hackstress -g 2 -f 4 \
    >/tmp/ci-nightly-hackstress.log 2>&1 &
stress_pid=$!

pressure_worker() {
    worker=$1
    i=0
    while [ "$i" -lt "$iterations" ]; do
        /bin/busybox dd if=/dev/zero of="/tmp/ci-pressure-$worker" \
            bs=4096 count=64 >/dev/null 2>&1 || exit 1
        /bin/busybox cp "/tmp/ci-pressure-$worker" \
            "/tmp/ci-pressure-$worker.copy" || exit 1
        /bin/busybox cmp "/tmp/ci-pressure-$worker" \
            "/tmp/ci-pressure-$worker.copy" || exit 1
        /bin/busybox rm -f "/tmp/ci-pressure-$worker" \
            "/tmp/ci-pressure-$worker.copy"
        i=$((i + 1))
    done
}

pressure_worker 1 & p1=$!
pressure_worker 2 & p2=$!
pressure_worker 3 & p3=$!
pressure_worker 4 & p4=$!

wait "$p1"; s1=$?
wait "$p2"; s2=$?
wait "$p3"; s3=$?
wait "$p4"; s4=$?
/bin/busybox kill -TERM "$stress_pid" || fail task-signal
wait "$stress_pid"; stress_status=$?

test "$s1" -eq 0 -a "$s2" -eq 0 -a "$s3" -eq 0 -a "$s4" -eq 0 \
    || fail io-worker
test "$stress_status" -eq 0 || fail task-worker
/bin/busybox grep -q '^Time:' /tmp/ci-nightly-hackstress.log \
    || fail task-cleanup
/bin/busybox sync || fail sync
test -r /proc/meminfo || fail heartbeat
echo CI_NIGHTLY_PRESSURE_PASS
