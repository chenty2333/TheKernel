set -e
echo 'KTAP version 1'
echo '1..1'
echo test_policy=reset > /proc/io_test_control
echo counters=on > /proc/io_test_control
echo virtio_counters=on > /proc/io_test_control
rm -f /ra_pressure /ra_small
dd if=/dev/zero of=/ra_pressure bs=4096 count=2304
sync
echo cached_readahead=on > /proc/io_test_control
echo counters=reset > /proc/io_test_control
dd if=/ra_pressure of=/dev/null bs=1000 count=1
dd if=/ra_pressure of=/dev/null bs=1000 skip=300 count=9000
stats=/proc/io_stats
value() { awk -v key="$1" '$1 == key { value = $2 } END { gsub(/\r/, "", value); if (value == "") exit 1; print value }' "$stats"; }
at_least() { [ "$(value "$1")" -ge "$2" ]; }
zero() { [ "$(value "$1")" -eq 0 ]; }
at_least cached.readahead_enabled 1
at_least cached.readahead_window_pages 64
at_least cached.readahead_misses 2
at_least cached.readahead_windows 1
at_least cached.readahead_pages 32
at_least cached.readahead_hits 16
at_least cached.readahead_retired_unused_pages 1
zero cached.readahead_pressure_skips
echo test_policy=reset > /proc/io_test_control
echo 'ok 1 - page-cache-readahead'
echo '# THEKERNEL_SMOKE_COMPLETE'
exit
