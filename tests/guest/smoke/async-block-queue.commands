set -e
echo 'KTAP version 1'
echo '1..1'
echo test_policy=reset > /proc/io_test_control
echo counters=on > /proc/io_test_control
echo virtio_counters=on > /proc/io_test_control
echo async_block=on > /proc/io_test_control
echo async_block_depth=4 > /proc/io_test_control
echo async_block_wait=hybrid > /proc/io_test_control
echo async_dirty_flush_sg=on > /proc/io_test_control
echo counters=reset > /proc/io_test_control
echo async_block_selftest_rw_scratch=vdb > /proc/io_test_control
echo async_block_adaptive=on > /proc/io_test_control
echo async_block_merge_write=on > /proc/io_test_control
rm -f /async_dirty /async_dirty_copy /async_rewrite /async_rewrite_copy /async_rewrite_expected
rm -f /async_trunc /async_trunc_expected /async_trim_first /async_trim_expected
i=0
while [ "$i" -lt 18 ]; do
    rm -f "/async_trim_$i"
    i=$((i + 1))
done
dd if=/dev/zero of=/async_dirty bs=4096 count=128
sync
echo counters=reset > /proc/io_test_control
dd if=/dev/zero of=/async_dirty bs=1024 count=512 conv=notrunc
sync
dd if=/async_dirty of=/async_dirty_copy bs=4096 count=128
cmp /async_dirty /async_dirty_copy
dd if=/dev/zero of=/async_rewrite bs=4096 count=128
sync
dd if=/bin/busybox of=/async_rewrite bs=1024 count=512 conv=notrunc
sync
dd if=/async_rewrite of=/async_rewrite_copy bs=4096 count=128
dd if=/bin/busybox of=/async_rewrite_expected bs=1024 count=512
cmp /async_rewrite_copy /async_rewrite_expected
dd if=/dev/zero of=/async_trunc bs=4096 count=128
sync
dd if=/bin/busybox of=/async_trunc bs=1024 count=512 conv=notrunc
truncate -s 262144 /async_trunc
sync
dd if=/bin/busybox of=/async_trunc_expected bs=1024 count=256
cmp /async_trunc /async_trunc_expected
i=0
while [ "$i" -lt 18 ]; do
    dd if=/bin/busybox of="/async_trim_$i" bs=1000 count=264
    i=$((i + 1))
done
sleep 6
sync
dd if=/async_trim_0 of=/async_trim_first bs=4096 count=1
dd if=/bin/busybox of=/async_trim_expected bs=4096 count=1
cmp /async_trim_first /async_trim_expected
echo async_block_selftest_irq_scratch=vdb > /proc/io_test_control
stats=/proc/io_stats
value() { awk -v key="$1" '$1 == key { value = $2 } END { gsub(/\r/, "", value); if (value == "") exit 1; print value }' "$stats"; }
at_least() { [ "$(value "$1")" -ge "$2" ]; }
zero() { [ "$(value "$1")" -eq 0 ]; }
at_least virtio.blk_async_submit_batches 1
at_least virtio.blk_async_submit_requests 8
at_least virtio.blk_async_completed_requests 8
at_least virtio.blk_async_max_depth 2
at_least virtio.blk_async_adaptive_enabled 1
at_least virtio.blk_async_adaptive_depth 2
at_least virtio.blk_async_adaptive_increases 1
at_least virtio.blk_async_adaptive_decreases 0
at_least virtio.blk_async_adaptive_good_events 2
at_least virtio.blk_async_adaptive_pressure_events 0
at_least virtio.blk_async_merge_write_enabled 1
at_least virtio.blk_async_merge_write_calls 1
at_least virtio.blk_async_merge_write_input_segments 64
at_least virtio.blk_async_merge_write_output_requests 1
at_least virtio.blk_async_merge_write_saved_requests 1
at_least virtio.blk_async_merge_write_max_segments 4
at_least virtio.blk_async_desc_budget 1
at_least virtio.blk_async_interrupt_drains 1
at_least cached.async_dirty_flush_hits 1
at_least cached.async_dirty_flush_pages 64
at_least cached.async_dirty_flush_bytes 262144
at_least cached.async_dirty_flush_sg_enabled 1
at_least cached.async_dirty_flush_sg_hits 1
at_least cached.async_dirty_flush_sg_segments 64
at_least cached.async_dirty_flush_bounce_fallbacks 0
zero cached.async_dirty_flush_errors
zero cached.async_dirty_flush_writeback_restarts
zero cached.closed_cache_trim_flush_errors
zero virtio.blk_async_completion_errors
zero virtio.blk_async_resource_leaks
echo test_policy=reset > /proc/io_test_control
echo 'ok 1 - async-block-queue'
echo '# THEKERNEL_SMOKE_COMPLETE'
exit
