set -e
echo 'KTAP version 1'
echo '1..1'
echo test_policy=reset > /proc/io_test_control
echo counters=on > /proc/io_test_control
echo virtio_counters=on > /proc/io_test_control
echo async_block=on > /proc/io_test_control
echo async_block_depth=4 > /proc/io_test_control
echo async_block_wait=irq_first > /proc/io_test_control
echo async_dirty_flush_sg=on > /proc/io_test_control
rm -f /async_irq_first_dirty /async_irq_first_copy /async_irq_first_expected
dd if=/dev/zero of=/async_irq_first_dirty bs=4096 count=128
sync
echo counters=reset > /proc/io_test_control
echo async_block_selftest_irq_first_scratch=vdb > /proc/io_test_control
dd if=/bin/busybox of=/async_irq_first_dirty bs=1024 count=512 conv=notrunc
sync
dd if=/async_irq_first_dirty of=/async_irq_first_copy bs=4096 count=128
dd if=/bin/busybox of=/async_irq_first_expected bs=1024 count=512
cmp /async_irq_first_copy /async_irq_first_expected
stats=/proc/io_stats
value() { awk -v key="$1" '$1 == key { value = $2 } END { gsub(/\r/, "", value); if (value == "") exit 1; print value }' "$stats"; }
at_least() { [ "$(value "$1")" -ge "$2" ]; }
zero() { [ "$(value "$1")" -eq 0 ]; }
[ "$(value virtio.blk_async_wait_policy)" -eq 2 ]
at_least virtio.blk_async_submit_requests 4
at_least virtio.blk_async_completed_requests 4
at_least cached.async_dirty_flush_sg_hits 1
at_least virtio.blk_async_irq_first_arms 1
at_least virtio.blk_async_irq_first_waits 2
zero virtio.blk_async_irq_first_fallback_unarmed
zero virtio.blk_async_completion_errors
zero virtio.blk_async_resource_leaks
echo test_policy=reset > /proc/io_test_control
echo 'ok 1 - async-irq-first'
echo '# THEKERNEL_SMOKE_COMPLETE'
exit
